# ---- Backend: copy this section to backend/.env ----
# SQLite is the zero-config default. For Postgres (docker-compose or Supabase):
# DATABASE_URL=postgresql+psycopg://vanta:vanta@localhost:5432/vanta
DATABASE_URL=sqlite:///./vanta.db

# Optional Redis cache for the morning brief. Falls back to in-process cache.
# REDIS_URL=redis://localhost:6379/0

# Optional: enables LLM-written narratives (evidence summaries, skeptic critiques,
# synthesis reasoning). All probabilities are computed by the quant engine either way.
# ANTHROPIC_API_KEY=sk-ant-...
VANTA_MODEL=claude-opus-5

# CORS origin for the frontend
FRONTEND_ORIGIN=http://localhost:3000

# Mutating requests per client per minute (0 disables)
# RATE_LIMIT_PER_MINUTE=240
# Require an X-API-Key (from POST /api/users) on operator mutations
# REQUIRE_API_KEY=1

# ---- Frontend: goes in frontend/.env.local, NOT backend/.env ----
# (Next.js only reads env files inside frontend/; the backend ignores this key.)
# NEXT_PUBLIC_API_URL=http://localhost:8000
